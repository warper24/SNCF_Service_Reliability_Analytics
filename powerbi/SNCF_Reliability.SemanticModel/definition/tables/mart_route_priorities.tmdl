		lineageTag: 0ad9d943-2f9e-4393-9d98-dff79560c88a
		summarizeBy: none
		sourceColumn: denominator_status

	partition mart_route_priorities = m
		mode: import
		source =
				let
				    Source = GoogleBigQuery.Database([BillingProject=pBillingProject, UseStorageApi=false]),
				    Project = Source{[Name=pProjectId]}[Data],
				    Dataset = Project{[Name=pDataset, Kind="Schema"]}[Data],
				    Data = Dataset{[Name="mart_route_priorities", Kind="Table"]}[Data],
				    Result = Table.TransformColumns(Data, {{"exclusion_reasons", each if _ = null then null else if Value.Is(_, type list) then Text.Combine(_, "; ") else Text.From(_), type text}}),
				    Versions = List.Distinct(Result[version_id]),
				    Checked = if List.Count(Versions) = 1 and Versions{0} = pExpectedVersion then Result else error "Version source inattendue ou multiple"
				in
				    Checked

	annotation PBI_ResultType = Table

