	partition mart_route_trends = m
		mode: import
		source =
				let
				    Source = GoogleBigQuery.Database([BillingProject=pBillingProject, UseStorageApi=false]),
				    Project = Source{[Name=pProjectId]}[Data],
				    Dataset = Project{[Name=pDataset, Kind="Schema"]}[Data],
				    Data = Dataset{[Name="mart_route_trends", Kind="Table"]}[Data],
				    Result = Table.TransformColumns(Data, {{"conversion_error_fields", each if _ = null then null else if Value.Is(_, type list) then Text.Combine(_, "; ") else Text.From(_), type text}, {"missing_schema_fields", each if _ = null then null else if Value.Is(_, type list) then Text.Combine(_, "; ") else Text.From(_), type text}, {"quality_reasons", each if _ = null then null else if Value.Is(_, type list) then Text.Combine(_, "; ") else Text.From(_), type text}}),
				    Versions = List.Distinct(Result[version_id]),
				    Checked = if List.Count(Versions) = 1 and Versions{0} = pExpectedVersion then Result else error "Version source inattendue ou multiple"
				in
				    Checked

